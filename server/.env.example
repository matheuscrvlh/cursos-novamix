# Banco (connection string do Postgres do Supabase — usar o Session pooler,
# já que o backend é um processo long-running, não serverless)
DATABASE_URL=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Ambiente (production/develop)
NODE_ENV=

#URLs
FRONTEND_URL=https://cursos.lojanovamix.com.br
BACKEND_URL=https://cursos.lojanovamix.com.br

#Auth
JWT_SECRET=
ADMIN_SEED_SENHA=

# secret separado, local a este projeto — login do cliente final (não é o
# mesmo JWT_SECRET do admin, que é compartilhado com hub-novamix)
CLIENTE_JWT_SECRET=

# E-mail (redefinição de senha, confirmação/status de inscrição, lembrete de
# curso) — sem SMTP_HOST configurado, o envio vira no-op (só loga, não quebra
# nada). SMTP_SECURE=true pra porta 465 (SSL direto), false pra 587 (STARTTLS).
#
# Webmail Locaweb: SMTP_HOST=email-ssl.com.br, SMTP_PORT=465, SMTP_SECURE=true
# (ou porta 587/SMTP_SECURE=false) — SMTP_USER é a caixa completa
# (ex: contato@lojanovamix.com.br), SMTP_PASS é a senha dessa caixa.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Novamix Cursos <nao-responda@lojanovamix.com.br>
