# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Ambiente (production/develop)
NODE_ENV=

#URLs
FRONTEND_URL=https://cursos.lojanovamix.com.br
BACKEND_URL=https://cursos.lojanovamix.com.br

#Auth
JWT_SECRET=
ADMIN_SEED_SENHA=

# Cliente
CLIENTE_JWT_SECRET=
CPF_ENCRYPTION_KEY=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Novamix Cursos <nao-responda@lojanovamix.com.br>
