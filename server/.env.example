# Banco (connection string do Postgres do Supabase — usar o Session pooler,
# já que o backend é um processo long-running, não serverless)
DATABASE_URL=

# Certificado da CA do Supabase (painel > Database > Settings > SSL
# Configuration > Download certificate), caminho relativo à pasta server/
# (ex: certs/supabase-ca.crt). Sem ele, a conexão com o banco não confere o
# certificado. Não colocar sslmode na DATABASE_URL — ele sobrescreve isso.
DATABASE_CA_CERT=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Ambiente (production/develop)
NODE_ENV=

#URLs
FRONTEND_URL=https://cursos.lojanovamix.com.br
BACKEND_URL=https://cursos.lojanovamix.com.br

#Auth
JWT_SECRET=
ADMIN_SEED_SENHA=

# Cliente
CLIENTE_JWT_SECRET=
CPF_ENCRYPTION_KEY=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Novamix Cursos <nao-responda@lojanovamix.com.br>
