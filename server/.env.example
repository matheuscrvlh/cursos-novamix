# Mercado Pago
# Teste:    token começa com TEST-
# Produção: token começa com APP_USR-
MP_ACCESS_TOKEN=

# Ambiente (production usa o link de pagamento real, qualquer outro valor usa sandbox)
NODE_ENV=

# URLs (o backend precisa de HTTPS para o webhook do MP funcionar em produção)
FRONTEND_URL=
BACKEND_URL=

# Webhook secret do MercadoPago (obrigatório em produção)
# Gere em: Painel MP → Seu negócio → Configurações → Webhooks → Chave secreta
MP_WEBHOOK_SECRET=

# Auth
JWT_SECRET=
ADMIN_SEED_SENHA=
